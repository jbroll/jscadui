{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.js",
    "packages/*/*.ts",
    "packages/*/*.js",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.js",
    "apps/*/*.ts",
    "apps/*/*.js",
    "file-format/*/*.ts",
    "file-format/*/*.js"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/build/**",
    "**/build_dev/**",
    "**/esm/**",
    "**/cjs/**",
    "**/jscad/**",
    "**/*.test.js",
    "**/*.test.ts",
    // jscad-web's storage pulls in @jbroll/rowboat-schema -> zod 4 types,
    // which need TS 5; the root gate runs TS 4.9. The web app is JS
    // (esbuild) and the API server typechecks with its own TS 5.7 toolchain.
    "apps/jscad-web/src/storage"
  ]
}
