{
  "name": "jscadui",
  "version": "0.1.0",
  "packageManager": "npm@10.9.4",
  "type": "module",
  "description": "Browser-based 3D CAD UI and libraries — source for jscad.rkroll.com",
  "main": "index.js",
  "workspaces": [
    "packages/*",
    "file-format/*",
    "apps/*"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "setup": "bash ci/lib/bootstrap.sh sources install deps",
    "fetch-sources": "node scripts/fetch-sources.js",
    "fetch-sources:update": "node scripts/fetch-sources.js --update",
    "fetch-deps": "node scripts/fetch-deps.js",
    "fetch-deps:update": "node scripts/fetch-deps.js --update",
    "fetch-deps:missing": "node scripts/fetch-deps.js --if-missing",
    "dev": "turbo dev",
    "jscad": "npm run jscad -w apps/jscad-web --",
    "jscad-chat": "npm run jscad-chat -w apps/jscad-web --",
    "build": "turbo build",
    "test": "node scripts/test-all.js",
    "test:unit": "turbo test --filter=!@jscadui/openscad --concurrency=8 && npx vitest run scripts/deps",
    "test:examples": "npm test -w apps/jscad-web",
    "test:openscad": "npm test -w packages/openscad",
    "test:e2e": "npm run test:e2e -w apps/jscad-web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-all": "bash ci/lib/bootstrap.sh deps grids examples",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "clean": "turbo clean && rm -rf node_modules/.cache",
    "prepare": "./scripts/setup-hooks.sh"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jbroll/jscadui.git"
  },
  "keywords": [
    "jscad",
    "cad",
    "3d",
    "openscad",
    "browser",
    "monorepo"
  ],
  "author": "John Roll <john@rkroll.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jbroll/jscadui/issues"
  },
  "homepage": "https://jscad.rkroll.com",
  "overrides": {
    "@jscad/modeling": "$@jscad/modeling",
    "@jscad/modeling-for-manifold": "$@jscad/modeling-for-manifold"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@jscad/modeling": "file:.deps-cache/OpenJSCAD.org/packages/modeling",
    "@jscad/modeling-for-manifold": "file:.deps-cache/OpenJSCAD.org/packages/modeling",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
