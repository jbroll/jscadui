{
  "compilerOptions": {
    "allowJs": true,
    "skipLibCheck": true,
    "outDir": "build_dev",
    "moduleResolution": "node16",
    "module": "node16"
  },
  "include": [
"src",
    "main.js"
],
  "exclude": ["node_modules", "build_dev", "build", "dist","build.js","jscad",
    // Vanilla JS tested by vitest; tsc here is TS 4.9 and cannot parse the
    // zod 4 types pulled in via @jbroll/rowboat-schema (see root tsconfig).
    "src/storage"]
}
