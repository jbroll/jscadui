      "HGH15CA_carriage", "HGH20CA_carriage"
    ]
  },
  "options": {
    "end_colour": "colour of the end caps",
    "wiper_colour": "colour of the end seals"
  },
  "example": "carriage(MGN12H_carriage)",
  "checks": [
    {
      "args": ["MGN12H_carriage"],
      "size": [45.4, 27, 10],
      "tol": 0.01,
      "source": "Hiwin MGN12H block datasheet: L 45.4, W 27, H 13, H1 3. The block spans z H1..H (3..13) above the rail base, so its own height is H - H1 = 10"
    }
  ]
}
