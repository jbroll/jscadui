{
  "type": "module",
  "name": "@jscadui/jscad-text",
  "version": "0.1.0",
  "description": "Text rendering for JSCAD - supports Hershey stroke fonts and TTF/OTF outline fonts",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./fontCache": {
      "import": "./src/fonts/fontCache.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@jscad/modeling": ">=2.12.0"
  },
  "devDependencies": {
    "@jscad/modeling": "file:../../.deps-cache/OpenJSCAD.org/packages/modeling",
    "@typopro/dtp-inconsolata": "3.7.5",
    "@typopro/dtp-lato": "3.7.5",
    "@typopro/dtp-liberation": "3.7.5",
    "@typopro/dtp-montserrat": "3.7.5",
    "@typopro/dtp-noto": "3.7.5",
    "@typopro/dtp-open-sans": "3.7.5",
    "@typopro/dtp-oswald": "3.7.5",
    "@typopro/dtp-roboto": "3.7.5",
    "@typopro/dtp-source-code-pro": "3.7.5",
    "@typopro/dtp-ubuntu": "3.7.5",
    "vitest": "^4.0.18"
  },
  "license": "MIT",
  "dependencies": {
    "opentype.js": "^1.3.4"
  }
}
