{
  "name": "@jscadui/agent-loop",
  "version": "0.1.0",
  "description": "Browser-local agent loop and provider adapters for JSCAD apps",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "src",
    "api",
    "prompt.md",
    "prompt",
    "log",
    "text-loader.js",
    "text-hooks.js"
  ],
  "scripts": {
    "test": "vitest run",
    "api-index": "node api/build-index.js",
    "read-log": "node log/read-log.js",
    "eval": "node --import ./text-loader.js eval/run-eval.js",
    "eval:keyless": "node --import ./text-loader.js eval/keyless.js",
    "grader-validate": "node --import ./text-loader.js eval/grader-validate.js",
    "describe": "node --import ./text-loader.js eval/describe.js",
    "judge": "node --import ./text-loader.js eval/judge.js"
  },
  "dependencies": {
    "@jscadui/format-common": "*"
  },
  "devDependencies": {
    "@jbroll/jscad-fluent": "file:../../.deps-cache/jscad-fluent",
    "@jscad/io": "*",
    "@jscadui/format-jscad": "*",
    "@jscadui/jscad-text": "*",
    "@jscadui/model-tools": "*",
    "@jscadui/params-core": "*",
    "@jscadui/require": "*",
    "@jscadui/transform-babel": "*",
    "@jscadui/worker": "*",
    "@playwright/test": "^1.58.2",
    "@typopro/dtp-inconsolata": "3.7.5",
    "@typopro/dtp-lato": "3.7.5",
    "@typopro/dtp-liberation": "3.7.5",
    "@typopro/dtp-montserrat": "3.7.5",
    "@typopro/dtp-noto": "3.7.5",
    "@typopro/dtp-open-sans": "3.7.5",
    "@typopro/dtp-oswald": "3.7.5",
    "@typopro/dtp-roboto": "3.7.5",
    "@typopro/dtp-source-code-pro": "3.7.5",
    "@typopro/dtp-ubuntu": "3.7.5",
    "three": "^0.147.0",
    "vitest": "^4.0.18"
  },
  "license": "MIT"
}
