#!/bin/sh
# Pre-commit hook: build, lint staged files, typecheck, fast unit tests.
# Runs on every commit. Heavy suites (JSCAD examples, OpenSCAD comparison,
# e2e) stay on the CI GPU host: `sci push jscadui/test` (see ci/README.md) —
# too slow and memory-intensive for a commit gate.
set -e

echo "Running pre-commit checks..."

# main takes only gated merges: develop on a branch and merge with
# scripts/ship.sh, which fast-forwards main solely on green simple-ci.
BRANCH=$(git branch --show-current 2>/dev/null || true)
if [ "$BRANCH" = "main" ] && [ "${JSCADUI_ALLOW_MAIN:-0}" != "1" ]; then
  echo "Direct commits to main are blocked: develop on a branch and merge with scripts/ship.sh (CI-gated)."
  echo "Bypass with JSCADUI_ALLOW_MAIN=1 (emergencies only)."
  exit 1
fi

# Build the openscad package (ensures transpiler JS is up to date)
echo "Building..."
npm run build --workspace=@jscadui/openscad

# Lint only staged JS/TS files
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|jsx|tsx)$' || true)

if [ -n "$STAGED_JS" ]; then
  echo "Linting staged files..."
  echo "$STAGED_JS" | xargs npx eslint --max-warnings=0
fi

# Type check
echo "Type checking..."
npm run typecheck

# Fast unit tests: every workspace except openscad (turbo, parallel), then
# the openscad vitest suite. Needs a built tree for bundle-dependent suites
# (e.g. fluent-worker): run `node apps/jscad-web/build.js` first on a fresh
# checkout.
echo "Running unit tests..."
npm run test:unit
npm run test:unit --workspace=@jscadui/openscad

echo "All pre-commit checks passed!"
