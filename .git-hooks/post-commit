#!/bin/sh
# Post-commit hook: run the quick local suites, and only if they pass,
# submit the tree to the GPU CI queue. Turbo-cached, so seconds when
# pre-commit just ran them; also covers commits made with --no-verify.
# Fire-and-forget: never fails the commit.

if ! command -v sci >/dev/null 2>&1; then
  echo "post-commit: sci not installed, skipping CI push"
  exit 0
fi

echo "post-commit: verifying quick local tests..."
LOG=/tmp/opencode/post-commit-test.log
if ! npm run test:unit >"$LOG" 2>&1 || ! npm run test:unit --workspace=@jscadui/openscad >>"$LOG" 2>&1; then
  echo "post-commit: local tests failed, skipping CI push (commit unaffected)"
  tail -20 "$LOG"
  exit 0
fi

# --supersede kills this worktree's previous queued/running job for the same
# script, so rapid commits don't pile up GPU jobs: each push tests a tree
# that includes everything before it.
TAG="commit-$(git rev-parse --short HEAD 2>/dev/null || echo manual)"
if JOB=$(sci push jscadui/test -t "$TAG" --supersede 2>&1 | tail -1); then
  echo "post-commit: local tests passed, CI job $JOB queued ($TAG); follow with: sci wait $TAG"
else
  echo "post-commit: CI push failed (commit unaffected)"
fi
exit 0
