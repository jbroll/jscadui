#!/usr/bin/env bash
set -euo pipefail

WORKTREE="$(cd "$(dirname "$0")/.." && pwd)"

# STL comparison is against whatever OpenSCAD the host has, so record which one.
openscad --version

# shellcheck source=ci/lib/bootstrap.sh
. "$WORKTREE/ci/lib/bootstrap.sh"
bootstrap sources install deps

# The root install covers this workspace; a second `npm install` from inside it
# crashes npm 11.16's arborist ("reading 'package'") on the CI host.
cd "$WORKTREE/packages/openscad"
# Pre-download Liberation fonts so text() works in Node.js (CDN fonts can't load synchronously)
node bin/download-fonts.js
export JSCADUI_CI=1
npm run test:local
