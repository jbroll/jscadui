#!/usr/bin/env bash
set -euo pipefail

WORKTREE="$(cd "$(dirname "$0")/.." && pwd)"

# STL comparison is against whatever OpenSCAD the host has, so record which one.
openscad --version

cd "$WORKTREE"
# file: dependencies (@jscad/modeling) point into .deps-cache; check out their
# pinned source repos before npm install resolves them.
node scripts/fetch-sources.js
npm install
# Third-party OpenSCAD sources are not committed; fetch-deps populates them
# (a no-op when they are already current).
node scripts/fetch-deps.js --if-missing

cd "$WORKTREE/packages/openscad"
npm install
# Pre-download Liberation fonts so text() works in Node.js (CDN fonts can't load synchronously)
node bin/download-fonts.js
export JSCADUI_CI=1
npm run test:local
