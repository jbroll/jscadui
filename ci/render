#!/usr/bin/env bash
# Browser render smoke test for all examples, run on the CI/GPU host.
#
#   sci push jscadui/render
#
# Starts the dev server, then drives a headless (bundled-chromium) browser
# through the real render pipeline for every example via
# apps/jscad-web/e2e/render-all.mjs. Honors skip.txt. Fails only where the run
# differs from the baseline: a new failure, a status change or a new dead cell.
#
# Scope/concurrency: edit RENDER_ARGS below (sci push runs this verbatim).
set -uo pipefail

WORKTREE="$(cd "$(dirname "$0")/.." && pwd)"
APP="$WORKTREE/apps/jscad-web"
# The timeout is a hang guard, not a performance budget: a model that renders
# slowly still renders. 300s per file leaves the app a 270s model budget, which
# is ~4x the slowest example measured single-threaded (rod.scad at 61s) with
# room for six pages competing for the box.
RENDER_ARGS="${RENDER_ARGS:---dir openscad --concurrency 6 --timeout 300000 --baseline e2e/render-baseline.json}"
# ci/render-grids sets RENDER_ARGS to sweep the ALL.js grids instead.

cd "$WORKTREE"
npm install
# Build workspace packages so the web bundle can resolve @jscadui/* esm outputs.
# --continue: an unrelated package (e.g. engine-test) failing must not abort the
# openscad build the web bundle depends on.
npm run build -- --continue || echo "build had failures (continuing — checking esm below)"
if [ ! -f packages/openscad/esm/index.js ]; then
  echo "✖ packages/openscad/esm not built"; exit 2
fi
( cd "$APP" && npm run build ) || { echo "✖ jscad-web build failed"; exit 2; }
# A production build content-hashes its entry, so the artifact is main.<hash>.js
# and index.html points at it; build/main.js never survives hashAssets.
if ! ls "$APP"/build/main.*.js >/dev/null 2>&1; then
  echo "✖ jscad-web build produced no hashed main entry"; exit 2
fi
( cd "$APP" && npx playwright install chromium )

# ── start dev server in background ──
# Another job's server on the port would answer the probes below and then vanish
# mid-sweep when that job exits, failing every later page as a crash.
if curl -s -o /dev/null http://localhost:5120/; then
  echo "✖ something already serves :5120 (another ci/render* or ci/web job?)"; exit 2
fi
cd "$APP"
node build.js --dev --skipDocs > /tmp/jscad-dev.log 2>&1 &
DEV_PID=$!
cleanup() { kill "$DEV_PID" 2>/dev/null; wait "$DEV_PID" 2>/dev/null; }
trap cleanup EXIT

# ── wait until the whole example tree is served ──
# One early file is not enough. The dev build copies ~36MB of examples while the
# server is already answering, so a sweep started at that point reports missing
# includes for every library copied later. Probe one deep file per library.
PROBES="
openscad/01-basics/lib/hardware.scad
openscad/bosl/lib/transforms.scad
openscad/bosl2/lib/std.scad
openscad/mcad/hardware.scad
openscad/nopscadlib/NopSCADlib/utils/core/core.scad
openscad/dotscad/util/set/_impl/_hashset_impl.scad
openscad/snippet/04-misc/Scene_City_Street.scad
openscad/text/ALL.js
"
echo "Waiting for dev server + example build…"
ready=no
for i in $(seq 1 300); do
  missing=
  for probe in $PROBES; do
    code=$(curl -s -o /dev/null -w '%{http_code}' "http://localhost:5120/examples/$probe" || true)
    [ "$code" = "200" ] || { missing="$probe"; break; }
  done
  [ -z "$missing" ] && { echo "ready after ${i}s"; ready=yes; break; }
  sleep 1
done
if [ "$ready" != "yes" ]; then
  echo "✖ dev server never served $missing; tail of dev log:"; tail -40 /tmp/jscad-dev.log
  exit 2
fi

# ── run the render sweep ──
echo "Running: node e2e/render-all.mjs $RENDER_ARGS"
node e2e/render-all.mjs $RENDER_ARGS
RC=$?
echo "render-all exit code: $RC"
exit $RC
