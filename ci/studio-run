#!/usr/bin/env bash
# Studio compute-frame tests, run on the CI host via simple-ci.
#
#   sci push jscadui/studio-run
#
# Runs apps/jscad-studio-run vitest (unit + parity; parity skips without a
# jscad-ai-studio checkout) and the Playwright frame suite. The browser suite
# stalls a dev laptop, so it never runs locally — use `npm run test:ci`.
#
# Ports 5121-5123 are fixed (same convention as ci/render's fixed 5120); two
# concurrent studio-run jobs would collide, which simple-ci rarely schedules.
set -euo pipefail

WORKTREE="$(cd "$(dirname "$0")/.." && pwd)"
APP="$WORKTREE/apps/jscad-studio-run"

cd "$WORKTREE"
npm install
# Build workspace packages so the frame bundle can resolve @jscadui/* esm outputs.
npm run build -- --continue || echo "build had failures (continuing — checking esm below)"
if [ ! -f packages/openscad/esm/index.js ]; then
  echo "✖ packages/openscad/esm not built"; exit 2
fi
( cd "$APP" && npx playwright install chromium )

# @jscad/modeling resolves to a manual mirror at
# /data/john/ci-worktrees/OpenJSCAD.org (s-ci owned; the GPU has no sibling
# checkout). Re-sync after local modeling changes with:
# rsync -az --delete --exclude node_modules -e "ssh -o BatchMode=yes" \
#   --rsync-path='sudo -n -u s-ci rsync' \
#   /home/john/src/OpenJSCAD.org/packages/modeling/ \
#   gpu:/data/john/ci-worktrees/OpenJSCAD.org/packages/modeling/
cd "$APP"
npx vitest run
npx playwright test
