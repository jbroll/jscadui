#!/usr/bin/env bash
# Unit suites for the web app and its API, run on the CI host.
#
#   sci push jscadui/web
#
# The render sweep lives in ci/render; this entry gates the app, AI chat and
# frame protocol e2e, since the frame is the only engine now.
set -euo pipefail

WORKTREE="$(cd "$(dirname "$0")/.." && pwd)"
APP="$WORKTREE/apps/jscad-web"

cd "$WORKTREE"
npm install
# The web suite imports @jscadui/* esm outputs; --continue so an unrelated
# package's build failure does not mask the suites below.
npm run build -- --continue || echo "workspace build had failures (continuing)"

cd "$APP"
npx vitest run

cd "$APP/server"
npm install
npx vitest run

cd "$APP"
npx playwright install chromium
npx playwright test e2e/app.spec.js e2e/ai-chat.spec.js e2e/frame.spec.js
