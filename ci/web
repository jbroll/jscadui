#!/usr/bin/env bash
# Unit suites for the web app and its API, run on the CI host.
#
#   sci push jscadui/web
#
# The render sweep lives in ci/render; this entry gates the app, AI chat,
# frame protocol, export and multi-model e2e, since the frame is the only
# engine now.
set -euo pipefail

WORKTREE="$(cd "$(dirname "$0")/.." && pwd)"
APP="$WORKTREE/apps/jscad-web"

# shellcheck source=ci/lib/bootstrap.sh
. "$WORKTREE/ci/lib/bootstrap.sh"
# ALL.js grids are gitignored; a cached host with current fetch-deps records
# skips organize-corpus, so grids regenerates them. The suites import the
# @jscadui/* esm outputs the workspace build writes.
bootstrap sources install deps grids workspace

cd "$APP"
npx vitest run

cd "$APP/server"
npm install
npx vitest run

# App, frame, marker and attacker origins take PORT..PORT+3 (e2e/ports.mjs),
# clear of the ci/render* jobs. Playwright reuses a server already on the app
# port, so another copy of this job would be tested against the wrong tree.
export JSCAD_WEB_PORT=5150
for p in 5150 5151 5152 5153; do
  if curl -s -o /dev/null "http://localhost:$p/"; then
    echo "✖ something already serves :$p (another copy of this job?)"; exit 2
  fi
done

cd "$APP"
npx playwright install chromium
npx playwright test e2e/app.spec.js e2e/ai-chat.spec.js e2e/frame.spec.js e2e/export.spec.js e2e/multi-model.spec.js
