#!/usr/bin/env bash
# Runs the agent-loop live-model eval suite on the CI host for every model x
# API style pair: models run concurrently, and each model runs its styles one
# after the other, so at most models x EVAL_CONCURRENCY conversations run at
# once.
#
#   sci push jscadui/eval
#
# Settings come from ci/eval.conf (EVAL_MODELS, EVAL_APIS, EVAL_FIXTURES,
# EVAL_RUNS, EVAL_CONCURRENCY); edit it in the working tree before pushing — sci push
# runs the tree as-is, uncommitted changes included. Provider keys come from
# the CI host user's ~/.config/jscad-chat/keys.json (placed there once,
# mode 600, outside this repo); see ci/README.md.
#
# Never runs on author trust alone for a ci/ or scripts/ diff (root
# ci/README.md's harness-pin gate) since it spends real API budget.
set -euo pipefail

WORKTREE="$(cd "$(dirname "$0")/.." && pwd)"
cd "$WORKTREE"

# file: dependencies (@jscad/modeling) point into .deps-cache; check out their
# pinned source repos before npm install resolves them.
node scripts/fetch-sources.js
npm install
# The eval imports @jscadui/* esm outputs; --continue so an unrelated
# package's build failure doesn't mask agent-loop's own build.
npm run build -- --continue || echo "workspace build had failures (continuing)"

# Model code runs only in the crt sandbox; fail the job before any provider
# call when the host lacks crt or its rootfs (ci/README.md, host setup).
if ! scripts/eval-sandbox-setup.sh --check; then
  echo "ci/eval: the eval sandbox is not set up on this host; see ci/README.md (Live model eval, host setup)" >&2
  exit 1
fi

# shellcheck source=ci/eval.conf
. "$WORKTREE/ci/eval.conf"

RESULTS_DIR="$WORKTREE/eval-results"
mkdir -p "$RESULTS_DIR"
export EVAL_RESULTS_DIR="$RESULTS_DIR"
export EVAL_LIVE_LOG="$RESULTS_DIR/eval-live.log"
export EVAL_RUNS EVAL_CONCURRENCY
[ -n "$EVAL_FIXTURES" ] && export EVAL_FIXTURES

KEYS_FILE="$HOME/.config/jscad-chat/keys.json"

pids=()
labels=()
job_failed=0

# provider:model, e.g. "meta:muse-spark-1.3-contributor opencode-go:deepseek-v4.1-flash"
# shellcheck disable=SC2086
for pair in $EVAL_MODELS; do
  provider="${pair%%:*}"
  model="${pair#*:}"
  if [ "$provider" = "$pair" ] || [ -z "$model" ]; then
    echo "ci/eval: skipping malformed EVAL_MODELS entry '$pair' (want provider:model)" >&2
    job_failed=1
    continue
  fi

  if [ ! -f "$KEYS_FILE" ]; then
    echo "ci/eval: $provider/$model — no keys file at $KEYS_FILE; place it on the CI host (mode 600) and re-run" >&2
    job_failed=1
    continue
  fi
  if ! node -e 'process.exit(require(process.argv[1])[process.argv[2]] ? 0 : 1)' "$KEYS_FILE" "$provider" 2>/dev/null; then
    echo "ci/eval: $provider/$model — no \"$provider\" key in $KEYS_FILE" >&2
    job_failed=1
    continue
  fi

  echo "ci/eval: starting $provider/$model ($EVAL_APIS)"
  (
    lane_failed=0
    # shellcheck disable=SC2086
    for api in $EVAL_APIS; do
      if ! EVAL_PROVIDER="$provider" EVAL_MODEL="$model" EVAL_API="$api" \
        npm run eval -w @jscadui/agent-loop; then
        echo "ci/eval: $provider/$model/$api — eval process failed" >&2
        lane_failed=1
      fi
    done
    exit "$lane_failed"
  ) &
  pids+=("$!")
  labels+=("$provider/$model")
done

for i in "${!pids[@]}"; do
  if ! wait "${pids[$i]}"; then
    echo "ci/eval: ${labels[$i]} — at least one API style failed" >&2
    job_failed=1
  fi
done

(
  shopt -s nullglob
  cd "$RESULTS_DIR"
  printf '%s\n' *.json
) > "$RESULTS_DIR/index.txt"

echo "ci/eval: results in $RESULTS_DIR"
cat "$RESULTS_DIR/index.txt"

exit "$job_failed"
