# crt create-config for the agent-loop eval sandbox (packages/agent-loop/eval/sandbox.js).
#   scripts/eval-sandbox-setup.sh   # runs: crt create jscad-eval ci/jscad-eval.crt
# The eval passes the isolation flags on every run; they are repeated here so
# a hand `crt run jscad-eval ...` is isolated too. The private /tmp and
# /dev/shm tmpfs are sized so a runaway writer hits its own cap; the cgroup
# charges those pages to the executor's memory limit as a second layer.
image     void
packages  nodejs
memory    2G
net       none
home      no
tmp       private
tmp-size  256M
shm-size  64M
env-clean yes
root      ro
